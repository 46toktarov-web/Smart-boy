function(){var m=Math.min(mx(),10),a=R(2,m),b=R(1,a-1),e=pick(E);return{q:a+" "+e+" болды, "+b+" кетті. Неше қалды?",big:new Array(a+1).join(e)+" ➖ "+new Array(b+1).join("❌"),o:opts3(a-b,0,m),a:a-b}}],
